# Caddy Reverse Proxy Configuration for Finance.ME
# Supports Local LAN, Internal Self-Signed TLS, or Automatic Let's Encrypt with DuckDNS / Custom Domain

{
    # In production with DuckDNS or custom domain, configure your email:
    # email contact@yourdomain.com
}

# Default configuration: binds to HTTP and HTTPS on all interfaces (LAN / Localhost)
:80, :443 {
    tls internal

    # Route backend REST API
    handle /api/* {
        reverse_proxy backend:5000
    }

    # Route frontend client application
    handle /* {
        reverse_proxy frontend:80
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
