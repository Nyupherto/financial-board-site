// Prisma Relational Schema for Finance.ME Financial Management Dashboard
// Uses SQLite for zero-config persistence with strict integer-cents currency fields.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("MEMBER")
  avatarColor  String   @default("#3b82f6")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions      Transaction[]
  savingsGoals      SavingsGoal[]
  allocationBuckets AllocationBucket[]
  monthlyRecords    MonthlyRecord[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // "INCOME" | "EXPENSE" | "SAVINGS"
  icon      String   @default("tag")
  color     String   @default("#64748b")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@unique([name, type])
  @@map("categories")
}

model MonthlyRecord {
  id                String   @id @default(uuid())
  year              Int
  month             Int      // 1 to 12
  userId            String?  // null indicates consolidated record; or individual user profile
  totalIncomeCents  Int      @default(0)
  totalPaidCents    Int      @default(0)
  totalPendingCents Int      @default(0)
  netCashFlowCents  Int      @default(0)
  isClosed          Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  allocations  AllocationBucket[]

  @@unique([year, month, userId])
  @@index([year, month])
  @@map("monthly_records")
}

model Transaction {
  id              String    @id @default(uuid())
  monthlyRecordId String?
  userId          String
  categoryId      String
  description     String
  amountCents     Int       // Always stored in integer cents
  type            String    // "INCOME" | "EXPENSE" | "SAVINGS"
  status          String    @default("PENDING") // "PAID" | "PENDING"
  dueDate         DateTime
  paidAt          DateTime?
  isShared        Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  monthlyRecord MonthlyRecord? @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([monthlyRecordId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@map("transactions")
}

model AllocationBucket {
  id                   String   @id @default(uuid())
  monthlyRecordId      String
  userId               String?
  bucketName           String
  targetPercentage     Float?
  allocatedAmountCents Int      @default(0)
  notes                String?
  createdAt            DateTime @default(now())

  monthlyRecord MonthlyRecord @relation(fields: [monthlyRecordId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([monthlyRecordId])
  @@map("allocation_buckets")
}

model SavingsGoal {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String   // Matches Savings Group name or individual goal name
  targetAmountCents        Int      // Target savings amount in cents
  initialPrincipalCents    Int      // Starting principal P in cents
  monthlyContributionCents Int      // Monthly PMT in cents
  annualInterestRateBps    Int      // Annual interest rate in Basis Points
  horizonMonths            Int      // Duration n in months
  currentBalanceCents      Int      @default(0)
  contributionTiming       String   @default("END_OF_PERIOD")
  isCompleted              Boolean  @default(false)
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("savings_goals")
}
